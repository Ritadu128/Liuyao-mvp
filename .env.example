# Server runtime
NODE_ENV=development
PORT=3000
TRUST_PROXY=false

# MySQL database used by server-side IP rate limiting
DATABASE_URL=mysql://liuyao_app:replace_with_a_strong_password@127.0.0.1:3306/liuyao_mvp

# DeepSeek: server-side only. Never expose this value in VITE_* variables or client code.
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_MS=60000

# Optional Manus OAuth integration. Leave unset for the anonymous-first version.
JWT_SECRET=replace_with_a_long_random_value_if_oauth_is_enabled
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=
OWNER_NAME=

# Public website metadata. These values are bundled into the client: never put secrets here.
# Fill these with the author's real public contact details before deployment.
VITE_CONTACT_EMAIL=
VITE_KOFI_URL=
